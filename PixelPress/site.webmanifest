      "sizes": "96x96",
      "type": "image/png"
    },
    {
      "src": "pixelpress-logo-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "pixelpress-mark.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
